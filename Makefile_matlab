BASE_DIR = $(PWD)/../../..
MATLAB_ROOT := $(shell dirname $(shell dirname $(shell readlink -f $(shell which matlab))))
MATLAB_MEX := $(MATLAB_ROOT)/bin/mex

MATLAB_LIB = -L${MATLAB_ROOT}/bin/glnxa64 -lmx -lmex
INCMUMPS = -I$(BASE_DIR)/include
INC = $(INCMUMPS)

# be aware with linking orders
LIBMUMPS = -L$(BASE_DIR)/lib -l$(ARITH)mumps -lmumps_common -lmpiseq -lpord
LIBFORT = -lgfortran
LIBBLAS = -L$(BASE_DIR)/lib -lopenblas
LIBMETIS = -L$(BASE_DIR)/lib -lmetis
LIBSCOTCH = -L$(BASE_DIR)/lib -lesmumps -lscotch -lscotcherr
LIB = $(LIBMUMPS) $(LIBMETIS) $(LIBSCOTCH) $(LIBBLAS) $(LIBFORT) $(MATLAB_LIB)

MEX = $(MATLAB_MEX) -largeArrayDims
OPTC = -O -DINTSIZE64 CFLAGS='$$CFLAGS -fopenmp -DINTSIZE64' LDFLAGS='$$LDFLAGS -fopenmp' 

# may required for gcc/gfortran >=10: FFLAGS='$FFLAGS -fallow-argument-mismatch -fallow-invalid-boz'

all:	d z

d:
	$(MAKE) ARITH=d dmumpsmex.stamp
z:
	$(MAKE) ARITH=z zmumpsmex.stamp

clean:
	rm -f dmumpsmex.* zmumpsmex*

$(ARITH)mumpsmex.stamp: mumpsmex.c
	cp -f mumpsmex.c $(ARITH)mumpsmex.c
	$(MEX) $(OPTC) $(ARITH)mumpsmex.c -DMUMPS_ARITH=MUMPS_ARITH_$(ARITH) $(INC) $(LIB)
	rm -f $(ARITH)mumpsmex.c
	touch $@
